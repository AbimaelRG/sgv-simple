# Copia este archivo como ".env". NUNCA subas ".env" ni claves a un repositorio.

# 1 = modo local (sin Firebase, para probar)   0 = Firebase
MODO_LOCAL=1

# --- Solo para MODO_LOCAL=0 (Firebase) ---
# Clave para firmar sesiones. Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Nombre del bucket de Storage (Consola de Firebase > Storage), ejemplo: mi-proyecto.firebasestorage.app
STORAGE_BUCKET=sgv-ver-1.firebasestorage.app
# Ruta completa al archivo .json de la cuenta de servicio (solo en tu PC; en Cloud Run no se usa)
GOOGLE_APPLICATION_CREDENTIALS=
