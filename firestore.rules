rules_version = '2';

// Reglas de seguridad de Cloud Firestore.
//
// En este sistema el navegador NUNCA habla directamente con Firestore: todas las
// lecturas y escrituras pasan por el backend (Flask en Cloud Run), que usa el
// Admin SDK. El Admin SDK no está sujeto a estas reglas, así que aquí se NIEGA
// todo acceso desde clientes. Es la configuración más segura para esta arquitectura:
// aunque alguien obtenga la configuración web pública de Firebase, no puede leer
// ni escribir datos.
//
// Los permisos por rol (administrador, responsable, técnico, auditor, gerencia)
// se verifican en el backend: ver reglas.py y seguridad.py.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
